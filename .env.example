# Configuración exclusiva del servidor. Copiar a .env y completar allí.
SERVICENOW_INSTANCE=
# OAuth sin inicio de sesión interactivo. Configurar también en Secrets de Streamlit.
SERVICENOW_AUTH_TYPE=client_credentials
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
# Opcional: scopes ya definidos en ServiceNow, separados por espacios.
SERVICENOW_OAUTH_SCOPE=
# Compatibilidad interna con conexiones anteriores (AUTH_TYPE=basic).
SERVICENOW_USER=
SERVICENOW_PASSWORD=
# Opcional: mapa JSON {"columna_local": "campo_servicenow"} por tabla.
SERVICENOW_CASE_FIELD_MAP={}
SERVICENOW_INCIDENT_FIELD_MAP={}
# Para tareas programadas: email de un administrador activo de la aplicación.
SERVICENOW_SYNC_ACTOR=
# Se activa al conectar desde la pantalla exclusiva de Admin.
SERVICENOW_SYNC_ENABLED=false
# Intervalo automático en segundos (mínimo 30).
SERVICENOW_SYNC_INTERVAL_SECONDS=120
# Usar la conexión PostgreSQL/Supabase existente.
SUPABASE_DATABASE_URL=
